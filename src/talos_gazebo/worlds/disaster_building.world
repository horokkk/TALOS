<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="disaster_building">

    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ============================================================ -->
    <!--  복합재난 사무실 건물 (지진+화재)                                -->
    <!--  12m x 10m, 4개 구역: 사무실A, 사무실B, 서버실, L자 복도        -->
    <!--  로봇 시작: 건물 외부 (0, -6.5)                                -->
    <!-- ============================================================ -->

    <!-- ==================== 외벽 ==================== -->
    <!-- 남쪽 벽 (Y=-5) — 출입구 (X=-0.6 ~ 0.6, 1.2m gap) -->
    <model name="wall_south_left">
      <static>true</static>
      <pose>-3.5 -5.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.0 0.15 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.15 2.0</size></box></geometry>
          <material>
            <ambient>0.45 0.42 0.40 1</ambient>
            <diffuse>0.45 0.42 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south_right">
      <static>true</static>
      <pose>3.5 -5.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.0 0.15 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.15 2.0</size></box></geometry>
          <material>
            <ambient>0.45 0.42 0.40 1</ambient>
            <diffuse>0.45 0.42 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 북쪽 벽 (Y=5) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0.0 5.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.0 0.15 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.0 0.15 2.0</size></box></geometry>
          <material>
            <ambient>0.45 0.42 0.40 1</ambient>
            <diffuse>0.45 0.42 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 서쪽 벽 (X=-6) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-6.0 0.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 10.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10.0 2.0</size></box></geometry>
          <material>
            <ambient>0.45 0.42 0.40 1</ambient>
            <diffuse>0.45 0.42 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 동쪽 벽 (X=6) -->
    <model name="wall_east">
      <static>true</static>
      <pose>6.0 0.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 10.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10.0 2.0</size></box></geometry>
          <material>
            <ambient>0.45 0.42 0.40 1</ambient>
            <diffuse>0.45 0.42 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 내벽: L자 복도 + 방 분리 ==================== -->

    <!-- 복도-사무실A 분리벽 (X=-2, Y=-5~1) — 문: Y=-2.6~-1.4 -->
    <model name="wall_officeA_west_lower">
      <static>true</static>
      <pose>-2.0 -3.9 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 2.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 2.0 2.0</size></box></geometry>
          <material>
            <ambient>0.50 0.48 0.45 1</ambient>
            <diffuse>0.50 0.48 0.45 1</diffuse>
          </material>
        </visual>
      </link>
