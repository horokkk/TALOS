<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="disaster_building">

    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ============================================================ -->
    <!--  복합재난 사무실 건물 (지진+화재)                                -->
    <!--  12m x 10m, 4개 구역: 사무실A, 사무실B, 서버실, L자 복도        -->
    <!-- ============================================================ -->

    <!-- ==================== 외벽 ==================== -->
    <!-- 남쪽 벽 (Y=-5) — 출입구 (X=-1 ~ 1, 2m gap) -->
    <model name="wall_south_left">
      <static>true</static>
      <pose>-3.5 -5.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.0 0.15 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.15 2.0</size></box></geometry>
          <material>
            <ambient>0.45 0.42 0.40 1</ambient>
            <diffuse>0.45 0.42 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south_right">
      <static>true</static>
      <pose>3.5 -5.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.0 0.15 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.15 2.0</size></box></geometry>
          <material>
            <ambient>0.45 0.42 0.40 1</ambient>
            <diffuse>0.45 0.42 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 북쪽 벽 (Y=5) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0.0 5.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.0 0.15 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.0 0.15 2.0</size></box></geometry>
          <material>
            <ambient>0.45 0.42 0.40 1</ambient>
            <diffuse>0.45 0.42 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 서쪽 벽 (X=-6) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-6.0 0.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 10.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10.0 2.0</size></box></geometry>
          <material>
            <ambient>0.45 0.42 0.40 1</ambient>
            <diffuse>0.45 0.42 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 동쪽 벽 (X=6) -->
    <model name="wall_east">
      <static>true</static>
      <pose>6.0 0.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 10.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 10.0 2.0</size></box></geometry>
          <material>
            <ambient>0.45 0.42 0.40 1</ambient>
            <diffuse>0.45 0.42 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 내벽 ==================== -->

    <!-- 복도-사무실A 분리벽 (X=-2) — 문: Y=-2.9~-1.3 (1.6m) -->
    <model name="wall_officeA_west_lower">
      <static>true</static>
      <pose>-2.0 -3.9 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 2.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 2.0 2.0</size></box></geometry>
          <material>
            <ambient>0.50 0.48 0.45 1</ambient>
            <diffuse>0.50 0.48 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_officeA_west_upper">
      <static>true</static>
      <pose>-2.0 -0.2 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 2.2 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 2.2 2.0</size></box></geometry>
          <material>
            <ambient>0.50 0.48 0.45 1</ambient>
            <diffuse>0.50 0.48 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 사무실A 북쪽 벽 (Y=1) -->
    <model name="wall_officeA_north">
      <static>true</static>
      <pose>-4.0 1.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.0 0.15 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 0.15 2.0</size></box></geometry>
          <material>
            <ambient>0.50 0.48 0.45 1</ambient>
            <diffuse>0.50 0.48 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- L자 복도 꺾이는 벽 — 서버실 문: X=0.4~1.6 -->
    <model name="wall_corridor_bend_left">
      <static>true</static>
      <pose>-0.7 1.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.4 0.15 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.4 0.15 2.0</size></box></geometry>
          <material>
            <ambient>0.50 0.48 0.45 1</ambient>
            <diffuse>0.50 0.48 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_corridor_bend_right">
      <static>true</static>
      <pose>2.0 1.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.15 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.15 2.0</size></box></geometry>
          <material>
            <ambient>0.50 0.48 0.45 1</ambient>
            <diffuse>0.50 0.48 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 서버실 벽 -->
    <model name="wall_server_east">
      <static>true</static>
      <pose>2.3 2.25 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 2.5 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 2.5 2.0</size></box></geometry>
          <material>
            <ambient>0.50 0.48 0.45 1</ambient>
            <diffuse>0.50 0.48 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_server_north">
      <static>true</static>
      <pose>1.3 3.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 0.15 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.15 2.0</size></box></geometry>
          <material>
            <ambient>0.50 0.48 0.45 1</ambient>
            <diffuse>0.50 0.48 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 사무실B 분리벽 — 문: X=3.5~4.7 -->
    <model name="wall_officeB_south_left">
      <static>true</static>
      <pose>2.9 1.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.15 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.15 2.0</size></box></geometry>
          <material>
            <ambient>0.50 0.48 0.45 1</ambient>
            <diffuse>0.50 0.48 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_officeB_south_right">
      <static>true</static>
      <pose>5.35 1.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.1 0.15 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.1 0.15 2.0</size></box></geometry>
          <material>
            <ambient>0.50 0.48 0.45 1</ambient>
            <diffuse>0.50 0.48 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 탐지 대상만 (통로 막지 않는 위치) ==================== -->

    <!-- 화재: 사무실A 벽 쪽 (빨간 원통) -->
    <include>
      <uri>model://red_cylinder</uri>
      <name>fire_office_a</name>
      <pose>-5.0 -2.0 0.0 0 0 0</pose>
    </include>

    <!-- 화재: 복도 벽 쪽 -->
    <include>
      <uri>model://red_cylinder</uri>
      <name>fire_corridor</name>
      <pose>4.0 -2.0 0.0 0 0 0</pose>
    </include>

    <!-- 위험물: 서버실 벽 쪽 (주황 박스) -->
    <include>
      <uri>model://orange_box</uri>
      <name>hazmat_server</name>
      <pose>1.8 2.8 0.0 0 0 0</pose>
    </include>

    <!-- 위험물: 사무실B 벽 쪽 -->
    <include>
      <uri>model://orange_box</uri>
      <name>hazmat_office_b</name>
      <pose>5.0 4.0 0.0 0 0 0</pose>
    </include>

    <!-- 생존자: 사무실A (벽 근처, 통로 방해 안함) -->
    <include>
      <uri>model://person_standing</uri>
      <name>victim_office_a</name>
      <pose>-4.5 -3.0 0.3 1.57 0 0.3</pose>
    </include>

    <!-- 생존자: 사무실B -->
    <include>
      <uri>model://person_standing</uri>
      <name>victim_office_b</name>
      <pose>4.5 3.0 0.3 1.57 0 -0.5</pose>
    </include>

    <!-- 생존자: 복도 (넓은 곳에 배치) -->
    <include>
      <uri>model://person_standing</uri>
      <name>victim_corridor</name>
      <pose>3.0 -3.0 0.3 1.57 0 0</pose>
    </include>

  </world>
</sdf>
