    <model name="wall_officeA_west_upper">
      <static>true</static>
      <pose>-2.0 -0.2 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 2.2 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 2.2 2.0</size></box></geometry>
          <material>
            <ambient>0.50 0.48 0.45 1</ambient>
            <diffuse>0.50 0.48 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 사무실A 북쪽 벽 (Y=1, X=-6~-2) -->
    <model name="wall_officeA_north">
      <static>true</static>
      <pose>-4.0 1.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.0 0.15 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 0.15 2.0</size></box></geometry>
          <material>
            <ambient>0.50 0.48 0.45 1</ambient>
            <diffuse>0.50 0.48 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- L자 복도 꺾이는 벽 (Y=1, X=-2~2) — 서버실 문: X=0.4~1.6 -->
    <model name="wall_corridor_bend_left">
      <static>true</static>
      <pose>-0.7 1.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.4 0.15 2.0</size></box></geometry>
