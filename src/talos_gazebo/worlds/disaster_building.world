    <!-- ==================== 지진 피해: 천장/벽 붕괴 잔해 ==================== -->

    <!-- 복도: 천장 콘크리트 덩어리 (통로 좁힘) -->
    <model name="ceiling_collapse_1">
      <static>true</static>
      <pose>0.0 -3.5 0.2 0.1 0.05 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.8 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.8 0.4</size></box></geometry>
          <material>
            <ambient>0.55 0.53 0.50 1</ambient>
            <diffuse>0.55 0.53 0.50 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 복도: 무너진 천장 파이프 -->
    <model name="fallen_pipe">
      <static>true</static>
      <pose>1.5 -1.5 0.15 0 0 0.8</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 0.12 0.12</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.12 0.12</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.35 1</ambient>
            <diffuse>0.35 0.35 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 사무실A: 쓰러진 책상 -->
    <model name="desk_collapsed_a1">
      <static>true</static>
      <pose>-4.0 -1.5 0.2 0 0.15 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.6 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.6 0.4</size></box></geometry>
          <material>
            <ambient>0.4 0.25 0.1 1</ambient>
            <diffuse>0.4 0.25 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 사무실A: 쓰러진 의자 -->
    <model name="chair_fallen_a">
      <static>true</static>
      <pose>-3.0 -3.0 0.12 0.5 0 -0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.25</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.25</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 사무실A: 벽에서 떨어진 콘크리트 -->
    <model name="wall_debris_a">
      <static>true</static>
      <pose>-5.0 -4.0 0.1 0 0 0.6</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.7 0.5 0.15</size></box></geometry>
