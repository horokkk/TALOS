    <!-- ==================== 화재 프록시 (빨간 원통) ==================== -->
    <!-- 복도 화재 -->
    <include>
      <uri>model://red_cylinder</uri>
      <name>fire_corridor</name>
      <pose>1.0 -0.5 0.0 0 0 0</pose>
    </include>

    <!-- 사무실A 화재 -->
    <include>
      <uri>model://red_cylinder</uri>
      <name>fire_office_a</name>
      <pose>-4.5 -0.2 0.0 0 0 0</pose>
    </include>

    <!-- ==================== 위험물 프록시 (주황 박스) ==================== -->
    <!-- 서버실 위험물 (과열된 배터리/화학물질) -->
    <include>
      <uri>model://orange_box</uri>
      <name>hazmat_server</name>
      <pose>1.8 2.0 0.0 0 0 0</pose>
    </include>

