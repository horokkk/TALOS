      <pose>4.0 2.5 0.3 1.57 0 -0.5</pose>
    </include>

    <!-- 복도: 대피 중 쓰러진 사람 -->
    <include>
      <uri>model://person_standing</uri>
      <name>victim_corridor</name>
      <pose>0.5 -4.0 0.3 1.57 0 0</pose>
